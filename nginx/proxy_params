# Shared proxy settings for every location that forwards to gunicorn.
# Mounted at /etc/nginx/proxy_params_xaninfarm.

proxy_pass http://xaninfarm_app;

proxy_http_version 1.1;
proxy_set_header Connection "";

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;

# Django's SECURE_PROXY_SSL_HEADER is ("HTTP_X_FORWARDED_PROTO", "https").
# Without this header the app cannot tell the request arrived over TLS and
# SECURE_SSL_REDIRECT would send it into a redirect loop.
proxy_set_header X-Forwarded-Proto $scheme;

proxy_redirect off;
proxy_buffering on;
proxy_buffer_size 8k;
proxy_buffers 16 8k;

proxy_connect_timeout 10s;
proxy_send_timeout    60s;
# Slightly under gunicorn's --timeout 60, so a stuck worker is killed by
# gunicorn rather than leaving nginx holding a dead connection.
proxy_read_timeout    55s;
