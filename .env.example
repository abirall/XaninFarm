# ---------------------------------------------------------------------------
# XaninFarm - environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate a secret key:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Site ---
SITE_NAME=XaninFarm
SITE_DOMAIN=xaninfarms.com
SITE_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_DB=xaninfarm
POSTGRES_USER=xaninfarm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional single-URL override; takes precedence over the POSTGRES_* vars above.
# DATABASE_URL=postgres://xaninfarm:change-me@db:5432/xaninfarm
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Email ---
# Dev default writes to the console. Point at Mailhog (compose) or real SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=XaninFarm <no-reply@xaninfarms.com>
ORDER_NOTIFICATION_EMAIL=orders@xaninfarms.com

# --- Storefront business rules ---
CURRENCY_CODE=BDT
DEFAULT_DELIVERY_FEE=60.00
FREE_DELIVERY_THRESHOLD=1500.00
LOW_STOCK_THRESHOLD=10
EXPIRY_ALERT_DAYS=3
# Minutes an unpaid order keeps its stock reservation before auto-release.
STOCK_RESERVATION_MINUTES=45

# --- Payments ---
# Comma separated. Available: cod, mock, bkash, nagad, sslcommerz
ENABLED_PAYMENT_PROVIDERS=cod,mock
PAYMENT_SANDBOX=True

# Mock sandbox provider (used when real gateway credentials are unavailable)
MOCK_PAYMENT_SECRET=mock-sandbox-secret

# bKash Checkout (https://developer.bka.sh)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=

# Nagad Merchant API
NAGAD_BASE_URL=https://sandbox.mynagad.com/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_WEBHOOK_SECRET=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True
SSLCOMMERZ_WEBHOOK_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=

# --- Container startup (read by docker/entrypoint.sh) ---
# Set RUN_MIGRATIONS=1 on exactly ONE container. If every web replica migrates
# on boot they race each other; the compose files already do this correctly.
RUN_MIGRATIONS=0
RUN_COLLECTSTATIC=0
WAIT_FOR_DB=1
WAIT_FOR_REDIS=0

# First-boot superuser. Leave the password blank to skip creation entirely.
# full_name is in REQUIRED_FIELDS, so --noinput needs all three.
CREATE_SUPERUSER=0
DJANGO_SUPERUSER_EMAIL=owner@xaninfarms.com
DJANGO_SUPERUSER_FULL_NAME=Farm Owner
DJANGO_SUPERUSER_PASSWORD=

# --- Optional Python dependency ---
# The Nagad provider signs requests with RSA and needs `cryptography`, which is
# not in requirements/base.txt. Install it only if you enable nagad above:
#   pip install cryptography
