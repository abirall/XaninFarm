# Normalise line endings.
#
# This project is developed on Windows and runs in Linux containers. Shell
# scripts and config files read inside a container must use LF, or they fail
# with errors that do not mention line endings at all.

* text=auto eol=lf

*.sh        text eol=lf
entrypoint  text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf

# Binary - never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
