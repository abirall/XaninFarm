{
  "name": "xaninfarm",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for the XaninFarm storefront",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./static/css/app.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^3.4.17"
  }
}
